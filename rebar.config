{erl_opts, [debug_info, {no_auto_import, [{get,1}]}]}.

{deps, [
    {lfe, "~> 2.2"}
]}.

{plugins, [
    {rebar3_lfe, "~> 0.4"},
    {rebar3_cargo, "~> 0.1"}
]}.

{provider_hooks, [
    {pre, [
        {compile, {cargo, build}},
        {compile, {lfe, compile}}
    ]}
]}.

%% macOS arm64: the cargo/linker ad-hoc signature on the music-comp-mt-linked
%% NIF dylib is rejected by dyld at dlopen (CODESIGNING Invalid Page -> SIGKILL),
%% even though `codesign --verify` passes. Force a clean ad-hoc re-sign of the
%% copied artifact before anything loads it. Darwin-only; a no-op elsewhere.
{pre_hooks, [
    {compile,
     "sh -c 'if [ \"$(uname)\" = Darwin ]; then "
     "codesign -f -s - priv/crates/uth_mt_nif/uth_mt_nif.so; fi'"}
]}.

{xref_checks, [
    undefined_function_calls, undefined_functions, locals_not_used,
    deprecated_function_calls, deprecated_functions
]}.

{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [eunit]}
]}.

{profiles, [
    {test, [
        {deps, [
            {proper, "1.3.0"},
            {ltest, "~> 0.13"}
        ]},
        {plugins, [
            {rebar3_proper, "0.12.1"}
        ]},
        {eunit_opts, [verbose]},
        {erl_opts, [
            {src_dirs, ["src", "test"]}
        ]}
    ]},
    {maintainer, [
        {plugins, [rebar3_hex]}
    ]}
]}.

{alias, [
    {ltest, [
        {lfe, ltest, "-tall"}
    ]},
    {coverage, [
        {proper, "-c"},
        {cover, "-v --min_coverage=0"}
    ]},
    {check, [
        compile,
        xref,
        %%dialyzer,
        {lfe, ltest, "-tall"},
        coverage
    ]},
    {publish, [
        compile,
        {hex, "publish package"}
    ]}
]}.

